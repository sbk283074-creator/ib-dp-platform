# Frontend build-time config (Vite env vars — must be prefixed with VITE_)
#
# Leave BOTH empty for the Netlify deployment: the app is served from the same
# origin as the API, so /api and /figures resolve relatively.
#
# For GitHub Pages (static frontend only, no backend on Pages), point the
# frontend at the LIVE Netlify backend so questions + figures still load:
VITE_API_BASE_URL=https://ib-dp-platform.netlify.app
VITE_FIGURES_BASE_URL=https://ib-dp-platform.netlify.app

# ---------------------------------------------------------------------------
# AI study assistant (Groq FREE tier, multi-model pool)
# ---------------------------------------------------------------------------
# 1) Get a free API key at https://console.groq.com/keys  (NO credit card needed).
# 2) Put it in a local .env file next to this example — backend/src/env.js loads
#    it automatically, and .env is already git-ignored. The key stays SERVER-SIDE
#    ONLY: never sent to the browser, never logged.
# 3) Leave it blank and /api/ask returns { configured:false } — the "Ask AI"
#    button does not appear and no network call is ever made. Nothing is billed.
# 4) This code ONLY calls Groq's free endpoint. There is no paid provider and no
#    auto-upgrade path, so it can never cost money.
GROQ_API_KEY=

# Model pool. Every Groq model has its OWN daily quota, so the code rotates
# across all of them: a 429 on one free model transparently falls through to the
# next. This multiplies usable capacity (~11,500 requests/day vs 1,000 for any
# single model). Order = quality first; the tail is only used when earlier
# models are capped. Leave GROQ_MODELS unset to use the built-in pool below:
#
#   openai/gpt-oss-120b  30 rpm /  1,000 rpd /  8K tpm / 200K tpd   (best)
#   openai/gpt-oss-20b   30 rpm /  1,000 rpd /  8K tpm / 200K tpd   (fast)
#   qwen/qwen3.6-27b     30 rpm /  1,000 rpd /  8K tpm / 200K tpd
#   qwen/qwen3.8-27b     30 rpm /  1,000 rpd /  8K tpm / 200K tpd
#   groq/compound-mini   30 rpm /    250 rpd / 70K tpm / unlimited tpd
#   groq/compound        30 rpm /    250 rpd / 70K tpm / unlimited tpd
#   allam-2-7b           30 rpm /  7,000 rpd /  6K tpm / 500K tpd   (bulk)
#
# Optional overrides:
#   GROQ_MODELS     comma-separated pool, e.g. "openai/gpt-oss-120b,qwen/qwen3.8-27b"
#   GROQ_MODEL      single preferred model (kept for backward compatibility; it is
#                   tried first, then the rest of the pool is used as failover)
#   AI_MAX_TOKENS   cap on answer length (default: 800; Groq caps output at 8,192)
#   GROQ_BASE_URL   only change this if you self-host an OpenAI-compatible proxy
#                   that is ALSO free; default points at api.groq.com.
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.6-27b,qwen/qwen3.8-27b
# AI_MAX_TOKENS=800

# Optional rate-limit tuning (defaults sit UNDER the pool's aggregate capacity so
# the app shows its own friendly message before Groq's hard cap is ever reached):
#   AI_IP_PER_MIN=15        max requests per IP per minute
#   AI_IP_PER_DAY=300       max requests per IP per day
#   AI_GLOBAL_PER_DAY=6000  global ceiling per day (aggregate pool ≈ 11,500)


