# Local Netlify folder
.netlify/

# Dependencies and build output
node_modules/
frontend/node_modules/
backend/node_modules/
frontend/dist/

# Local databases, imports, and runtime files
backend/*.db
backend/*.db-*
backend/data/
backend/generated/
backend/backend.log
backend/*.log
backend/**/backend.log
backend/**/__pycache__/

# Local secrets and environment files
.env
.env.*
!.env.example

# Generated local OCR / import artifacts
backend/ocr/*.jsonl
backend/ocr/*.json
backend/ocr/book_json2/
backend/ocr/specimen_json/

# Local scratch: throwaway debug scripts, logs and pre-fix backups.
# Never commit these -- _backup_preidfix/ alone is ~560 MB of superseded crops.
backend/ocr/_*/
backend/ocr/_*.py
backend/ocr/_*.sh

# Large local figure corpus; production figures belong in Netlify Blob storage
backend/public/figures/
backend/public/figures_orphaned/

# OS/editor files
.DS_Store

# Vite writes a timestamped copy of vite.config.ts while it starts and normally
# deletes it on exit -- but it is left behind if the dev server is killed
# mid-start, and then shows up as an untracked file.
*.timestamp-*.mjs

